# Copy to .env (never commit it) and fill in. Local dev: `set -a; source .env; set +a`.

# azure | openai | scripted | none
LLM_PROVIDER=azure

# Azure OpenAI in Microsoft Foundry: the resource endpoint, e.g. https://my-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# Key for local dev. When hosted, leave empty and set AZURE_USE_MANAGED_IDENTITY=true instead.
AZURE_OPENAI_API_KEY=
AZURE_USE_MANAGED_IDENTITY=false

# Deployment names (what you named the model deployments in Foundry)
AGENT_MODEL=gpt-5-mini
# Optional: rerun with a larger model when confidence is low
ESCALATION_MODEL=
ESCALATION_CONFIDENCE=0.6

# Optional model parameters (GPT-5 family: leave temperature unset)
LLM_TEMPERATURE=
LLM_REASONING_EFFORT=low

# Agent limits
MAX_STEPS=14
MAX_RUN_TOKENS=150000

# Public demo protection
LIVE_RUNS_PER_IP_PER_HOUR=5
MAX_CONCURRENT_LIVE_RUNS=3
DAILY_BUDGET_USD=2
# USD per 1M tokens [input, output] per deployment name; check Azure pricing for your region
MODEL_PRICES={"gpt-5-mini":[0.25,2.0],"gpt-5":[1.25,10.0]}
